# ==============================================================================
# 1. CONFIGURACIÓN GENERAL DE LA APLICACIÓN (LARAVEL 12)
# ==============================================================================
APP_NAME="PuntoÁgil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Managua
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==============================================================================
# 2. BASE DE DATOS POSTGRESQL / SUPABASE
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# ==============================================================================
# 3. SESIONES, COOKIES, CACHÉ, COLAS Y ARCHIVOS
# ==============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ==============================================================================
# 4. GOOGLE OAUTH 2.0 (INICIO DE SESIÓN Y REGISTRO CON GOOGLE)
# ==============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ==============================================================================
# 5. CORREO ELECTRÓNICO TRANSACCIONAL (SMTP)
# ==============================================================================
MAIL_MAILER="log"
MAIL_HOST="127.0.0.1"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="no-reply@puntoagil.com"
MAIL_FROM_NAME="PuntoÁgil SaaS"

# ==============================================================================
# 6. PASARELAS DE PAGO Y WEBHOOKS DE SUSCRIPCIONES (STRIPE / MERCADOPAGO)
# ==============================================================================
STRIPE_KEY=""
STRIPE_SECRET=""
STRIPE_WEBHOOK_SECRET=""

MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
